# Пример переменных окружения Nova.
# Скопируй нужные значения в apps/landing/.env.local или задай в панели хостинга.

# --- Веб-клиент / сайт (apps/landing) ---

# Адрес бэкенда Nova (вшивается в статический клиент на этапе сборки).
NEXT_PUBLIC_NOVA_API=http://localhost:8081

# Внешний хостинг файлов сборок (GitHub Releases / Cloudflare R2).
# Если не задан — ссылки ведут на локальную папку /downloads.
NEXT_PUBLIC_DOWNLOADS_BASE=

# --- Бэкенд (apps/server) ---

# Интерфейс и порт, который слушает сервер.
HOST=0.0.0.0
PORT=8081

# --- Десктоп-приложение (apps/desktop) ---

# Адрес сервера для Electron-обёртки.
NOVA_SERVER_URL=http://localhost:8081

# --- Android-приложение (apps/mobile) ---

# Адрес сервера по умолчанию, вшивается в APK при сборке.
NOVA_API_URL=

# Пароль ключа подписи Android (по умолчанию nova-mobile).
NOVA_ANDROID_KEYSTORE_PASSWORD=
