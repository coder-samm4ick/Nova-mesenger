# ===== КОНФИГ БОТА NEBULA =====
# 1) Впиши сюда токен бота (получи его у @BotFather в Telegram)
# 2) Сохрани файл как .env (убери приставку .example)

# Токен бота — обязателен
BOT_TOKEN=

# Твой chat_id для приёма заявок (необязательно):
# получи его у @userinfobot, впиши цифрами, например 123456789
# Если оставить пустым — заявки будут просто подтверждаться клиенту
OWNER_CHAT_ID=

# Контакт менеджера (показывается клиентам)
CONTACT=@Kvezovs

# Название студии
STUDIO_NAME=NEBULA

# Юридические документы (страницы на Telegraph)
DOCS_OFFER=https://telegra.ph/PUBLICHNAYA-OFERTA-08-12-15
DOCS_PRIVACY=https://telegra.ph/POLITIKA-KONFIDENCIALNOSTI-08-12-99

# ===== FreeKassa (приём оплат) =====
# Числовой ID мерчанта из панели freekassa.ru (после активации) — обязателен
FK_MERCHANT_ID=
# Секретные слова из формы «Активация мерчанта»
FK_SECRET1=
FK_SECRET2=
# Каким словом формируется контрольная подпись (по панели — 2)
FK_SIGN_SECRET=2
# Порт локального вебхук-сервера оплат
FK_WEBHOOK_PORT=8090
# Допустимый диапазон суммы предоплаты в боте
FK_MIN_AMOUNT=100
FK_MAX_AMOUNT=100000