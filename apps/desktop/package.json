{
  "name": "@nova/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nova — десктоп-клиент для Windows, macOS и Linux",
  "homepage": "https://coder-samm4ick.github.io/Nova-mesenger/",
  "author": {
    "name": "Nova",
    "email": "hello@nova.chat",
    "url": "https://coder-samm4ick.github.io/Nova-mesenger/"
  },
  "main": "main.js",
  "scripts": {
    "prepare-renderer": "node scripts/prepare-renderer.mjs",
    "make-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-cert.ps1",
    "start": "npm run prepare-renderer && electron .",
    "pack": "npm run prepare-renderer && electron-builder --win --dir",
    "dist": "node scripts/build.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "chat.nova.desktop",
    "productName": "Nova",
    "executableName": "Nova",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "static-server.js",
      "renderer/**/*",
      "icon.png",
      "package.json"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nova",
      "artifactName": "nova-setup-x64.${ext}"
    },
    "portable": {
      "artifactName": "nova-portable.exe"
    },
    "linux": {
      "icon": "icon.png",
      "category": "Network",
      "synopsis": "Nova — мессенджер нового поколения",
      "mimeTypes": [
        "x-scheme-handler/nova"
      ]
    },
    "appImage": {
      "artifactName": "nova-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "nova-amd64.deb"
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.social-networking",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "nova-${arch}.${ext}"
    }
  }
}
